# Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/finstaq_db?schema=public"

# Security & Authentication
JWT_SECRET="super-secret-jwt-signing-key-change-this-in-production-min32chars"
JWT_EXPIRES_IN="7d"

# Field Encryption Key (32-byte hex string for AES-256-GCM)
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS
CORS_ORIGIN="*"

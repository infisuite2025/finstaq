# ==============================================================================
# Finstaq Production Environment Variables
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (MySQL 8.0)
DATABASE_URL="mysql://finstaq_user:FinstaqSecurePass2026!@mysql:3306/finstaq_production?schema=public&sslmode=prefer"

# Redis Queue & Caching URL
REDIS_URL="redis://:RedisSecurePass2026!@redis:6379"

# Security & Authentication (Generate using: openssl rand -base64 48)
JWT_SECRET="generate-a-strong-random-64-character-secret-in-production"
JWT_EXPIRES_IN="7d"

# Field Encryption Key (64 hex characters = 32 bytes AES-256 key: openssl rand -hex 32)
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS Origin Allowed Domains (Comma-separated)
CORS_ORIGIN="https://app.finstaq.io,https://admin.finstaq.io"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

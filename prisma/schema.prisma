  nature             String       @db.VarChar(20) // ASSET, LIABILITY, INCOME, EXPENSE, EQUITY
  openingBalanceDr   Decimal      @default(0) @map("opening_balance_dr") @db.Decimal(15, 2)
  openingBalanceCr   Decimal      @default(0) @map("opening_balance_cr") @db.Decimal(15, 2)
  gstIn              String?      @map("gst_in") @db.VarChar(32)
  pan                String?      @db.VarChar(20)
  stateCode          String?      @map("state_code") @db.VarChar(10)
  aiConfidence       Decimal      @default(0.99) @map("ai_confidence") @db.Decimal(5, 2)
  isResolved         Boolean      @default(true) @map("is_resolved")
  status             String       @default("PENDING") @db.VarChar(30)
  createdAt          DateTime     @default(now()) @map("created_at")

  migrationJob       MigrationJob @relation(fields: [migrationJobId], references: [id], onDelete: Cascade)

  @@index([migrationJobId])
  @@index([tenantId])
  @@map("staged_ledgers")
}

model StagedItem {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  migrationJobId     String       @map("migration_job_id") @db.VarChar(36)
  tenantId           String       @map("tenant_id") @db.VarChar(36)
  name               String       @db.VarChar(255)
  sku                String       @db.VarChar(100)
  hsnCode            String       @map("hsn_code") @db.VarChar(20)
  uom                String       @db.VarChar(20)
  openingStockQty    Decimal      @default(0) @map("opening_stock_qty") @db.Decimal(15, 3)
  openingStockRate   Decimal      @default(0) @map("opening_stock_rate") @db.Decimal(15, 2)
  openingStockValue  Decimal      @default(0) @map("opening_stock_value") @db.Decimal(15, 2)
  warehouseName      String?      @map("warehouse_name") @db.VarChar(100)
  gstRatePercent     Decimal      @default(18) @map("gst_rate_percent") @db.Decimal(5, 2)
  isResolved         Boolean      @default(true) @map("is_resolved")
  createdAt          DateTime     @default(now()) @map("created_at")

  migrationJob       MigrationJob @relation(fields: [migrationJobId], references: [id], onDelete: Cascade)

  @@index([migrationJobId])
  @@index([tenantId])
  @@map("staged_items")
}

model StagedVoucher {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  migrationJobId     String       @map("migration_job_id") @db.VarChar(36)
  tenantId           String       @map("tenant_id") @db.VarChar(36)
  voucherNumber      String       @map("voucher_number") @db.VarChar(100)
  voucherType        String       @map("voucher_type") @db.VarChar(20)
  date               String       @db.VarChar(20)
  narration          String?      @db.Text
  fiscalYear         String       @map("fiscal_year") @db.VarChar(20)
  totalDebit         Decimal      @map("total_debit") @db.Decimal(15, 2)
  totalCredit        Decimal      @map("total_credit") @db.Decimal(15, 2)
  itemsJson          Json         @map("items_json")
  createdAt          DateTime     @default(now()) @map("created_at")

  migrationJob       MigrationJob @relation(fields: [migrationJobId], references: [id], onDelete: Cascade)

  @@index([migrationJobId])
  @@index([tenantId])
  @@map("staged_vouchers")
}

model StagedBillAllocation {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  migrationJobId     String       @map("migration_job_id") @db.VarChar(36)
  tenantId           String       @map("tenant_id") @db.VarChar(36)
  partyLedgerName    String       @map("party_ledger_name") @db.VarChar(255)
  partyType          String       @map("party_type") @db.VarChar(20) // DEBTOR, CREDITOR
  billNumber         String       @map("bill_number") @db.VarChar(100)
  billDate           String       @map("bill_date") @db.VarChar(20)
  dueDate            String?      @map("due_date") @db.VarChar(20)
  pendingAmount      Decimal      @map("pending_amount") @db.Decimal(15, 2)
  createdAt          DateTime     @default(now()) @map("created_at")

  migrationJob       MigrationJob @relation(fields: [migrationJobId], references: [id], onDelete: Cascade)

  @@index([migrationJobId])
  @@index([tenantId])
  @@map("staged_bill_allocations")
}

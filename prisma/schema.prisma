// Prisma Schema for Finstaq - Multi-Tenant Financial SaaS
// Dialect: MySQL

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER
  ACCOUNTANT
  DATA_ENTRY
}

enum VoucherType {
  RECEIPT
  PAYMENT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
}

enum BillReferenceType {
  NEW_REF
  AGST_REF
  ADVANCE
}

enum InventoryValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
}

enum DocumentDraftStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum GroupNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum GrnQcStatus {
  PENDING
  ACCEPTED
  PARTIALLY_REJECTED
  REJECTED
}

enum ThreeWayMatchStatus {
  PERFECT_MATCH
  PRICE_VARIANCE
  QUANTITY_VARIANCE
  DISCREPANCY_FLAGGED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DISPATCHED
  COMPLETED
  CANCELLED
}

enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum HsnType {
  GOODS
  SERVICES
}

// -----------------------------------------------------------------------------
// MULTI-TENANCY & IDENTITY
// -----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  gstIn     String?  @map("gst_in") @db.VarChar(32)
  taxId     String?  @map("tax_id") @db.VarChar(64)
  currency  String   @default("INR") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users               User[]
  ledgerGroups        LedgerGroup[]
  ledgers             Ledger[]
  vouchers            Voucher[]
  inventoryItems      InventoryItem[]
  documentDrafts      DocumentDraft[]
  auditLogs           AuditLog[]
  purchaseOrders      PurchaseOrder[]
  goodsReceiptNotes   GoodsReceiptNote[]
  threeWayMatches     ThreeWayMatchRecord[]
  salesOrders         SalesOrder[]
  deliveryChallans    DeliveryChallan[]
  
  // Dynamic Masters Relations
  unitsOfMeasurement  UnitOfMeasurement[]
  itemCategories      ItemCategory[]
  warehouses          Warehouse[]
  costCenters         CostCenter[]
  paymentTerms        PaymentTerm[]
  taxRates            TaxRateMaster[]
  hsnSacCodes         HsnSacDirectory[]
  currencies          CurrencyMaster[]
  voucherSeries       VoucherSeriesMaster[]

  @@index([gstIn])
  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.VarChar(36)
  tenantId     String    @map("tenant_id") @db.VarChar(36)
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(DATA_ENTRY)
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vouchers      Voucher[]       @relation("UserVouchers")
  auditLogs     AuditLog[]
  documentDrafts DocumentDraft[]

  @@unique([tenantId, email], name: "tenant_user_email_unique")
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// DOUBLE-ENTRY ACCOUNTING CORE (CHART OF ACCOUNTS & VOUCHERS)
// -----------------------------------------------------------------------------

model LedgerGroup {
  id                 String      @id @default(uuid()) @db.VarChar(36)
  tenantId           String      @map("tenant_id") @db.VarChar(36)
  name               String      @db.VarChar(150)
  code               String?     @db.VarChar(50)
  parentId           String?     @map("parent_id") @db.VarChar(36)
  nature             GroupNature @default(ASSET)
  affectsGrossProfit Boolean     @default(false) @map("affects_gross_profit")
  isSystem           Boolean     @default(false) @map("is_system")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   LedgerGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children LedgerGroup[] @relation("GroupHierarchy")
  ledgers  Ledger[]

  @@unique([tenantId, name], name: "tenant_ledger_group_name_unique")
  @@index([tenantId])
  @@index([parentId])
  @@map("ledger_groups")
}

model Ledger {
  id               String   @id @default(uuid()) @db.VarChar(36)
  tenantId         String   @map("tenant_id") @db.VarChar(36)
  groupId          String   @map("group_id") @db.VarChar(36)
  name             String   @db.VarChar(200)
  code             String?  @db.VarChar(50)
  gstIn            String?  @map("gst_in") @db.VarChar(32)
  pan              String?  @db.VarChar(20)
  contactPerson    String?  @map("contact_person") @db.VarChar(100)
  email            String?  @db.VarChar(150)
  phone            String?  @db.VarChar(50)
  address          String?  @db.Text
  stateCode        String?  @map("state_code") @db.VarChar(10)
  creditPeriodDays Int?     @default(30) @map("credit_period_days")
  creditLimit      Decimal? @default(0.0000) @map("credit_limit") @db.Decimal(18, 4)
  bankAccount      String?  @map("bank_account") @db.VarChar(50)
  ifscCode         String?  @map("ifsc_code") @db.VarChar(20)
  openingBalance   Decimal  @default(0.0000) @map("opening_balance") @db.Decimal(18, 4)
  currentBalance   Decimal  @default(0.0000) @map("current_balance") @db.Decimal(18, 4)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group               LedgerGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  voucherItems        VoucherItem[]
  vendorPurchaseOrders PurchaseOrder[]        @relation("VendorPurchaseOrders")
  vendorGRNs          GoodsReceiptNote[]     @relation("VendorGRNs")
  customerSalesOrders    SalesOrder[]           @relation("CustomerSalesOrders")
  customerDeliveryChallans DeliveryChallan[]    @relation("CustomerDeliveryChallans")

  @@unique([tenantId, name], name: "tenant_ledger_name_unique")
  @@unique([tenantId, code], name: "tenant_ledger_code_unique")
  @@index([tenantId])
  @@index([groupId])
  @@map("ledgers")
}

model Voucher {
  id                            String      @id @default(uuid()) @db.VarChar(36)
  tenantId                      String      @map("tenant_id") @db.VarChar(36)
  type                          VoucherType
  voucherNumber                 String      @map("voucher_number") @db.VarChar(100)
  date                          DateTime    @db.Date
  narration                     String?     @db.Text
  isSystemGenerated             Boolean     @default(false) @map("is_system_generated")
  sourceModule                  String?     @map("source_module") @db.VarChar(50)
  sourceDocumentId              String?     @map("source_document_id") @db.VarChar(100)
  sourceDocumentNumber          String?     @map("source_document_number") @db.VarChar(100)
  isReversed                    Boolean     @default(false) @map("is_reversed")
  reversalVoucherId             String?     @map("reversal_voucher_id") @db.VarChar(36)
  adjustmentReferenceVoucherId  String?     @map("adjustment_reference_voucher_id") @db.VarChar(36)
  createdBy                     String      @map("created_by") @db.VarChar(36)
  createdAt                     DateTime    @default(now()) @map("created_at")
  updatedAt                     DateTime    @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator         User                  @relation("UserVouchers", fields: [createdBy], references: [id], onDelete: Restrict)
  items           VoucherItem[]
  threeWayMatches ThreeWayMatchRecord[]

  @@unique([tenantId, type, voucherNumber], name: "tenant_voucher_number_unique")
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, isSystemGenerated])
  @@index([sourceModule, sourceDocumentNumber])
  @@index([createdBy])
  @@map("vouchers")
}

model VoucherItem {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  voucherId          String             @map("voucher_id") @db.VarChar(36)
  ledgerId           String             @map("ledger_id") @db.VarChar(36)
  debitAmount        Decimal            @default(0.0000) @map("debit_amount") @db.Decimal(18, 4)
  creditAmount       Decimal            @default(0.0000) @map("credit_amount") @db.Decimal(18, 4)
  billReferenceType  BillReferenceType? @map("bill_reference_type")
  referenceNumber    String?            @map("reference_number") @db.VarChar(100)
  notes              String?            @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at")

  // Relations
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger  Ledger  @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([ledgerId])
  @@map("voucher_items")
}

// -----------------------------------------------------------------------------
// DYNAMIC MASTERS SUBSYSTEM (ZERO HARDCODING)
// -----------------------------------------------------------------------------

model UnitOfMeasurement {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  symbol        String   @db.VarChar(30)
  formalName    String   @map("formal_name") @db.VarChar(100)
  uqc           String?  @db.VarChar(10)
  decimalPlaces Int      @default(0) @map("decimal_places")
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([tenantId, symbol], name: "tenant_uom_symbol_unique")
  @@index([tenantId])
  @@map("units_of_measurement")
}

model ItemCategory {
  id             String         @id @default(uuid()) @db.VarChar(36)
  tenantId       String         @map("tenant_id") @db.VarChar(36)
  name           String         @db.VarChar(150)
  code           String?        @db.VarChar(50)
  parentId       String?        @map("parent_id") @db.VarChar(36)
  defaultHsn     String?        @map("default_hsn") @db.VarChar(20)
  defaultTaxRate Decimal?       @map("default_tax_rate") @db.Decimal(5, 2)
  description    String?        @db.Text
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent         ItemCategory?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       ItemCategory[]  @relation("CategoryHierarchy")
  inventoryItems InventoryItem[]

  @@unique([tenantId, name], name: "tenant_item_category_name_unique")
  @@index([tenantId])
  @@index([parentId])
  @@map("item_categories")
}

model Warehouse {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  code          String   @db.VarChar(50)
  name          String   @db.VarChar(150)
  address       String?  @db.Text
  city          String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  pincode       String?  @db.VarChar(20)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(50)
  isPrimary     Boolean  @default(false) @map("is_primary")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([tenantId, code], name: "tenant_warehouse_code_unique")
  @@index([tenantId])
  @@map("warehouses")
}

model CostCenter {
  id        String   @id @default(uuid()) @db.VarChar(36)
  tenantId  String   @map("tenant_id") @db.VarChar(36)
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(150)
  category  String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code], name: "tenant_cost_center_code_unique")
  @@index([tenantId])
  @@map("cost_centers")
}

model PaymentTerm {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(150)
  days        Int      @default(0)
  description String?  @db.VarChar(255)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code], name: "tenant_payment_term_code_unique")
  @@index([tenantId])
  @@map("payment_terms")
}

model TaxRateMaster {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  cgstPercent Decimal  @default(0.00) @map("cgst_percent") @db.Decimal(5, 2)
  sgstPercent Decimal  @default(0.00) @map("sgst_percent") @db.Decimal(5, 2)
  igstPercent Decimal  @default(0.00) @map("igst_percent") @db.Decimal(5, 2)
  cessPercent Decimal  @default(0.00) @map("cess_percent") @db.Decimal(5, 2)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name], name: "tenant_tax_rate_name_unique")
  @@index([tenantId])
  @@map("tax_rate_masters")
}

model HsnSacDirectory {
  id             String   @id @default(uuid()) @db.VarChar(36)
  tenantId       String   @map("tenant_id") @db.VarChar(36)
  code           String   @db.VarChar(20)
  type           HsnType  @default(GOODS)
  description    String   @db.VarChar(255)
  defaultGstRate Decimal  @default(18.00) @map("default_gst_rate") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code], name: "tenant_hsn_code_unique")
  @@index([tenantId])
  @@map("hsn_sac_directory")
}

model CurrencyMaster {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  code          String   @db.VarChar(10)
  name          String   @db.VarChar(100)
  symbol        String   @db.VarChar(10)
  decimalPlaces Int      @default(2) @map("decimal_places")
  exchangeRate  Decimal  @default(1.0000) @map("exchange_rate") @db.Decimal(18, 6)
  isBase        Boolean  @default(false) @map("is_base")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code], name: "tenant_currency_code_unique")
  @@index([tenantId])
  @@map("currency_masters")
}

model VoucherSeriesMaster {
  id            String      @id @default(uuid()) @db.VarChar(36)
  tenantId      String      @map("tenant_id") @db.VarChar(36)
  voucherType   VoucherType @map("voucher_type")
  prefix        String      @db.VarChar(30)
  suffix        String?     @db.VarChar(30)
  currentSeq    Int         @default(1) @map("current_seq")
  paddingLength Int         @default(4) @map("padding_length")
  resetPeriod   String      @default("YEARLY") @map("reset_period") @db.VarChar(20)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, voucherType, prefix], name: "tenant_voucher_series_unique")
  @@index([tenantId])
  @@map("voucher_series_masters")
}

// -----------------------------------------------------------------------------
// INVENTORY MANAGEMENT
// -----------------------------------------------------------------------------

model InventoryItem {
  id               String                   @id @default(uuid()) @db.VarChar(36)
  tenantId         String                   @map("tenant_id") @db.VarChar(36)
  name             String                   @db.VarChar(200)
  sku              String?                  @db.VarChar(100)
  category         String?                  @db.VarChar(100)
  categoryId       String?                  @map("category_id") @db.VarChar(36)
  uomId            String?                  @map("uom_id") @db.VarChar(36)
  warehouseId      String?                  @map("warehouse_id") @db.VarChar(36)
  hsnCode          String?                  @map("hsn_code") @db.VarChar(20)
  taxRatePercent   Decimal?                 @default(18.00) @map("tax_rate_percent") @db.Decimal(5, 2)
  unit             String                   @default("PCS") @db.VarChar(20)
  closingStockQty  Decimal                  @default(0.0000) @map("closing_stock_qty") @db.Decimal(18, 4)
  reorderLevel     Decimal?                 @default(0.0000) @map("reorder_level") @db.Decimal(18, 4)
  valuationMethod  InventoryValuationMethod @default(FIFO) @map("valuation_method")
  standardCost     Decimal?                 @default(0.0000) @map("standard_cost") @db.Decimal(18, 4)
  sellingPrice     Decimal?                 @default(0.0000) @map("selling_price") @db.Decimal(18, 4)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  // Relations
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemCategory         ItemCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitOfMeasurement    UnitOfMeasurement?     @relation(fields: [uomId], references: [id], onDelete: SetNull)
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptNoteItems GoodsReceiptNoteItem[]
  salesOrderItems      SalesOrderItem[]
  deliveryChallanItems DeliveryChallanItem[]

  @@unique([tenantId, sku], name: "tenant_inventory_sku_unique")
  @@index([tenantId])
  @@index([categoryId])
  @@index([uomId])
  @@index([warehouseId])
  @@map("inventory_items")
}

// -----------------------------------------------------------------------------
// DOCUMENT INTAKE & OCR / AI PIPELINE
// -----------------------------------------------------------------------------

model DocumentDraft {
  id             String              @id @default(uuid()) @db.VarChar(36)
  tenantId       String              @map("tenant_id") @db.VarChar(36)
  fileUrl        String              @map("file_url") @db.VarChar(1000)
  parsedDataJson Json?               @map("parsed_data_json")
  status         DocumentDraftStatus @default(PENDING_REVIEW)
  createdBy      String?             @map("created_by") @db.VarChar(36)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // Relations
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("document_drafts")
}

// -----------------------------------------------------------------------------
// IMMUTABLE AUDIT LOGGING (SECURITY & COMPLIANCE)
// -----------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid()) @db.VarChar(36)
  tenantId   String      @map("tenant_id") @db.VarChar(36)
  userId     String?     @map("user_id") @db.VarChar(36)
  action     AuditAction
  entityName String      @map("entity_name") @db.VarChar(100)
  entityId   String      @map("entity_id") @db.VarChar(36)
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  diffJson   Json?       @map("diff_json")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, entityName, entityId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// PURCHASE & PROCUREMENT LIFECYCLE
// -----------------------------------------------------------------------------

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.VarChar(36)
  tenantId             String              @map("tenant_id") @db.VarChar(36)
  poNumber             String              @map("po_number") @db.VarChar(100)
  vendorLedgerId       String              @map("vendor_ledger_id") @db.VarChar(36)
  orderDate            DateTime            @map("order_date") @db.Date
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Date
  status               PurchaseOrderStatus @default(ISSUED)
  totalTaxable         Decimal             @default(0.0000) @map("total_taxable") @db.Decimal(18, 4)
  totalTax             Decimal             @default(0.0000) @map("total_tax") @db.Decimal(18, 4)
  grandTotal           Decimal             @default(0.0000) @map("grand_total") @db.Decimal(18, 4)
  termsAndConditions   String?             @map("terms_and_conditions") @db.Text
  createdBy            String?             @map("created_by") @db.VarChar(36)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorLedger      Ledger               @relation("VendorPurchaseOrders", fields: [vendorLedgerId], references: [id], onDelete: Restrict)
  items             PurchaseOrderItem[]
  goodsReceiptNotes GoodsReceiptNote[]
  threeWayMatches   ThreeWayMatchRecord[]

  @@unique([tenantId, poNumber], name: "tenant_po_number_unique")
  @@index([tenantId])
  @@index([vendorLedgerId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

